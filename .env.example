# Skopíruj ako .env a vyplň. Súbor .env nikdy nedávaj na GitHub.

# --- Doména a názov ---
DOMAIN=kukatko.sk
SITE_URL=https://kukatko.sk
SITE_NAME=Kukátko
CONTACT_EMAIL=

# --- Jazyky (prvý je predvolený a nemá v adrese predponu) ---
# sk = Slovensko, cs = Česko, en = Veľká Británia, pl = Poľsko, hu = Maďarsko, de = Nemecko
LOCALES=sk,cs,en,pl,hu,de

# --- Databáza (beží v Dockeri na tvojom VPS) ---
# Heslo vygeneruješ príkazom: openssl rand -hex 24   (len písmená a čísla)
POSTGRES_USER=kukatko
POSTGRES_PASSWORD=
POSTGRES_DB=kukatko

# --- TMDB (zadarmo): https://www.themoviedb.org/settings/api ---
# Stačí jedno z dvoch. Odporúčaný je "API Read Access Token".
TMDB_TOKEN=
TMDB_API_KEY=
# Koľko strán populárnych titulov sťahovať každú noc pre každú krajinu (1 strana = 20 titulov)
SYNC_PAGES=15
SYNC_MOVIE_PAGES=15

# --- OMDb (zadarmo, 1000 dopytov denne): https://www.omdbapi.com/apikey.aspx ---
OMDB_API_KEY=
OMDB_DAILY_LIMIT=900

# --- Push upozornenia (zadarmo, bez Firebase) ---
# Vygeneruješ: docker compose run --rm --no-deps worker node node_modules/tsx/dist/cli.mjs worker/cli.ts vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tvoj@email.sk

# --- Administrácia (/admin): moderovanie recenzií, štatistiky klikov ---
# Aspoň 12 znakov, napr.: openssl rand -hex 16
ADMIN_TOKEN=
# Po koľkých nahláseniach sa recenzia skryje do kontroly
REVIEW_REPORT_LIMIT=3

# --- Monitoring (voliteľné, zadarmo na healthchecks.io) ---
HC_NIGHTLY_URL=
HC_HOURLY_URL=
HC_BACKUP_URL=

# --- Zálohy ---
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14

# --- Reklama (voliteľné) ---
ADSENSE_CLIENT=
ADSENSE_SLOT=

# --- Štatistiky návštevnosti Umami (voliteľné, profil "analytics") ---
UMAMI_APP_SECRET=
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# --- Prémium bez reklám (predvolene VYPNUTÉ) ---
PREMIUM_ENABLED=false
PREMIUM_PRICE_LABEL=1,99 €
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Android appka (vyplníš po vytvorení appky cez Bubblewrap) ---
TWA_PACKAGE=
TWA_SHA256=

# Ako dlho (v sekundách) si web pamätá rovnaké dopyty (rebríčky, zoznamy). 0 = vypnuté.
CACHE_TTL=300

TZ_DISPLAY=Europe/Bratislava
